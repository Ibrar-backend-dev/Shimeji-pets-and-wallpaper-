# =============================================================================
# Copy to .env and fill in. NEVER commit .env - only this example file.
#   cp .env.example .env
#
# Every variable the project reads is listed here. Anything marked REQUIRED
# will abort startup in production (see config/settings/prod.py).
#
# IMPORTANT: comments go on their own line, never after a value.
# django-environ does not strip trailing comments, so `FOO=1  # note` is read
# as the literal string "1  # note". That crashes on an int, silently becomes
# False on a bool, and turns an intentionally-blank string into a truthy one.
# tests/test_env_example.py enforces this.
# =============================================================================

# --- Core -------------------------------------------------------------------
# REQUIRED in prod. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True

# Comma-separated. REQUIRED in prod, and must not contain '*'.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full scheme+host origins, for the admin's CSRF protection.
# REQUIRED in prod if you use the admin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Mount the admin somewhere non-obvious in prod.
# No leading slash; keep the trailing one.
DJANGO_ADMIN_URL=admin/

# Comma-separated origins for a web front-end. Android clients do not need this.
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Leave blank in dev to fall back to SQLite (db.sqlite3), so the project runs
# with no Postgres installed. REQUIRED in prod.
#
# Neon: use the POOLED endpoint - its host contains "-pooler". That endpoint is
# pgbouncer in transaction mode, which is why prod.py pins CONN_MAX_AGE=0 and
# disables server-side cursors. The direct endpoint works but handles far fewer
# concurrent workers; `manage.py check_deploy` warns when you use it.
#
#   postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Backblaze B2 (S3-compatible API) ---------------------------------------
# From B2 > Application Keys. Needs read AND write on the bucket below.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Region-specific S3 endpoint, shown on the bucket detail page.
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Public base URL that fronts the bucket. No trailing slash.
#
# Behind Cloudflare (recommended): https://cdn.yourdomain.com
#   B2 egress via Cloudflare is free; direct B2 egress is billed.
# Straight from B2 (simpler, needs no domain):
#   https://f004.backblazeb2.com/file/your-bucket-name
MEDIA_CDN_BASE_URL=https://cdn.example.com

# --- Upload policy ----------------------------------------------------------
# Seconds the browser has to finish its PUT. 900 = 15 minutes.
PRESIGN_EXPIRY_SECONDS=900

# Resumable v2 uploads: sessions survive browser reloads; each part URL still
# has the short PRESIGN_EXPIRY_SECONDS lifetime and can be renewed.
MULTIPART_SESSION_EXPIRY_SECONDS=86400
MULTIPART_PART_SIZE_BYTES=10485760
MULTIPART_MAX_PART_URLS=100
MULTIPART_MAX_CONCURRENCY=3

# Maximum files per presign/commit request.
UPLOAD_BULK_MAX_FILES=50

# 12 MiB. Images above this must be committed with a supplied preview rather
# than being pulled into the app process.
INLINE_PROCESS_MAX_BYTES=12582912

# Days an archived item's bytes survive on B2 before the reaper purges them.
ARCHIVE_RETENTION_DAYS=30

# Zip-bomb ceilings, applied to Shimeji packs.
ZIP_MAX_ENTRIES=2000
ZIP_MAX_UNCOMPRESSED_BYTES=268435456
ZIP_MAX_COMPRESSION_RATIO=100

# Generated preview box, in pixels. Aspect ratio is preserved.
PREVIEW_MAX_EDGE=720
PREVIEW_JPEG_QUALITY=82

# --- API behaviour ----------------------------------------------------------
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100

# Paging deeper than this must use ?cursor=.
API_MAX_SKIP=10000

# Cache-Control max-age on list responses, in seconds.
API_LIST_CACHE_SECONDS=300

# How long a filtered COUNT(*) is reused, in seconds.
API_COUNT_CACHE_SECONDS=60

# How long the taxonomy (types, categories, manifest) is cached, in seconds.
API_CONFIG_CACHE_SECONDS=120

# Minimum seconds between AppClient.last_used_at writes, so reads never become
# writes.
APP_CLIENT_TOUCH_INTERVAL_SECONDS=600

# --- Internal cron ----------------------------------------------------------
# REQUIRED in prod, minimum 16 characters. Sent as the X-Cron-Secret header by
# your scheduler. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=dev-only-cron-secret

# --- Optional ---------------------------------------------------------------
# If set, replaces the local-memory cache. Leave blank to use LocMemCache.
REDIS_URL=

# If set, enables Sentry error reporting. Leave blank to disable.
SENTRY_DSN=

LOG_LEVEL=INFO

# True emits one JSON object per line; False gives readable console logs.
LOG_JSON=True
