# =============================================================================
# Copy to .env and fill in. NEVER commit .env — only this example file.
#   cp .env.example .env
# Every variable the project reads is listed here. Anything marked REQUIRED
# will abort startup in production if missing (see config/settings/prod.py).
# =============================================================================

# --- Core -------------------------------------------------------------------
# REQUIRED in prod. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True

# Comma-separated. REQUIRED in prod (no wildcard fallback).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full scheme+host origins for the admin/CSRF. REQUIRED in prod if you use the admin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Mount the admin somewhere non-obvious in prod. No leading slash, keep the trailing one.
DJANGO_ADMIN_URL=admin/

# --- Database ---------------------------------------------------------------
# Leave blank in dev to fall back to SQLite (db.sqlite3) so the project runs
# with no Postgres installed. REQUIRED in prod.
#
# Neon: use the POOLED (-pooler) host. Transaction-mode pgbouncer is why
# CONN_MAX_AGE is 0 and server-side cursors are disabled — see prod.py.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Backblaze B2 (S3-compatible API) ---------------------------------------
# From B2 > Application Keys. The key needs read+write on the bucket below.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Region-specific S3 endpoint, shown on the bucket detail page.
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Public base URL that fronts the bucket. Put Cloudflare in front of the B2
# friendly URL and point this at your own hostname — B2 egress via Cloudflare
# is free, direct B2 egress is not. No trailing slash.
MEDIA_CDN_BASE_URL=https://cdn.example.com

# --- Upload policy ----------------------------------------------------------
PRESIGN_EXPIRY_SECONDS=900          # 15 min for the browser to finish its PUT
UPLOAD_BULK_MAX_FILES=50            # per presign/commit request
INLINE_PROCESS_MAX_BYTES=12582912   # 12 MiB: above this a preview must be supplied
ARCHIVE_RETENTION_DAYS=30           # archived items purged from B2 after this

# --- API behaviour ----------------------------------------------------------
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
API_MAX_SKIP=10000                  # deeper paging must use ?cursor=
API_LIST_CACHE_SECONDS=300          # Cache-Control max-age on list responses
API_COUNT_CACHE_SECONDS=60          # how long a filtered COUNT(*) is reused

# --- Internal cron ----------------------------------------------------------
# REQUIRED in prod. Sent as the X-Cron-Secret header by your scheduler.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=dev-only-cron-secret

# --- Optional ---------------------------------------------------------------
REDIS_URL=                          # if set, replaces the local-memory cache
SENTRY_DSN=                         # if set, enables error reporting
LOG_LEVEL=INFO
LOG_JSON=True                       # False gives human-readable console logs
